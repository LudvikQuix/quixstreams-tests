# ============================================================
#               🚀 Quix CLI guidelines 🚀
# ============================================================
# Push this .env into quix.yaml:   quix pipeline update
# Pull quix.yaml into this .env:   quix init --update
# ============================================================

### Quix SDK Configuration ###
Quix__Portal__Api=https://portal-api.testrig.dev.quix.io
Quix__Organisation__Id=testrigorg

# Active environment: "Dashboard Test"  (project: quixstreams tests, git branch: devDB)
Quix__Workspace__Id=testrigorg-quixstreamstests-dashboardtest

# Alternative environment: "QuixStream Pipeline" (git branch: dev)
# Quix__Workspace__Id=testrigorg-quixstreamstests-quixstr-df57e12b

# Personal Access Token — PASTE HERE.
# Portal → user menu → Personal Access Tokens (PAT).
Quix__Pat__Token=

### Topics ###
# Naming is from the PIPELINE's point of view, not the dashboard's:
#   dashboard-in  = commands the dashboard SENDS  (dashboard writes, SIL reads)
#   dashboard-out = telemetry the dashboard READS (SIL writes, dashboard reads)
dashboard_in=dashboard-in
dashboard_out=dashboard-out

### Lexicon / DCM ###
# Topic the Dynamic Configuration Manager publishes signal+parameter definitions on
dcm_config=dashboard-config

### Local dev ###
# Uncomment to run against the local broker instead of Quix Cloud (quix pipeline up)
# Quix__Broker__Address=localhost:19092
